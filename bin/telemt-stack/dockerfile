FROM debian:12-slim

ARG TARGETARCH
ARG TELEMT_REPOSITORY=telemt/telemt
ARG TELEMT_VERSION=latest
ARG TELEMT_PANEL_REPOSITORY=amirotin/telemt_panel
# latest = newest GitHub release including prereleases (non-draft).
# latest-stable = GitHub /releases/latest (excludes prereleases).
ARG TELEMT_PANEL_VERSION=latest

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        jq \
        tar; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) release_arch="x86_64" ;; \
        arm64) release_arch="aarch64" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    resolve_release_tag() { \
        repository="$1"; \
        version="$2"; \
        include_prerelease="$3"; \
        if [ "${version}" != "latest" ] && [ "${version}" != "latest-stable" ]; then \
            printf '%s\n' "${version}"; \
            return 0; \
        fi; \
        if [ "${version}" = "latest-stable" ] || [ "${include_prerelease}" != "true" ]; then \
            tag="$(curl -fsSL \
                -H 'Accept: application/vnd.github+json' \
                -H 'User-Agent: AutoDockerBuilder-telemt-stack' \
                "https://api.github.com/repos/${repository}/releases/latest" \
                | jq -r '.tag_name // empty')"; \
        else \
            tag="$(curl -fsSL \
                -H 'Accept: application/vnd.github+json' \
                -H 'User-Agent: AutoDockerBuilder-telemt-stack' \
                "https://api.github.com/repos/${repository}/releases?per_page=20" \
                | jq -r '[.[] | select(.draft == false)][0].tag_name // empty')"; \
        fi; \
        if [ -z "${tag}" ] || [ "${tag}" = "null" ]; then \
            echo "Unable to resolve release tag for ${repository} (version=${version})" >&2; \
            exit 1; \
        fi; \
        printf '%s\n' "${tag}"; \
    }; \
    download_release_asset() { \
        repository="$1"; \
        version="$2"; \
        asset="$3"; \
        output="$4"; \
        url="https://github.com/${repository}/releases/download/${version}/${asset}"; \
        curl -fL --retry 5 --retry-delay 2 "${url}" -o "${output}"; \
    }; \
    install_binary_from_archive() { \
        archive="$1"; \
        binary="$2"; \
        destination="$3"; \
        tmpdir="$(mktemp -d)"; \
        tar -xzf "${archive}" -C "${tmpdir}"; \
        found="$(find "${tmpdir}" -type f -name "${binary}" | head -n 1)"; \
        if [ -z "${found}" ]; then \
            found="$(find "${tmpdir}" -type f -name "${binary}-*" | head -n 1)"; \
        fi; \
        if [ -z "${found}" ]; then \
            echo "Binary ${binary} not found in ${archive}" >&2; \
            find "${tmpdir}" -maxdepth 3 -type f >&2; \
            exit 1; \
        fi; \
        install -m 0755 "${found}" "${destination}"; \
        rm -rf "${tmpdir}"; \
    }; \
    telemt_tag="$(resolve_release_tag "${TELEMT_REPOSITORY}" "${TELEMT_VERSION}" false)"; \
    panel_tag="$(resolve_release_tag "${TELEMT_PANEL_REPOSITORY}" "${TELEMT_PANEL_VERSION}" true)"; \
    echo "Resolved telemt=${telemt_tag} telemt-panel=${panel_tag}"; \
    telemt_asset="telemt-${release_arch}-linux-gnu.tar.gz"; \
    telemt_panel_asset="telemt-panel-${release_arch}-linux-gnu.tar.gz"; \
    download_release_asset "${TELEMT_REPOSITORY}" "${telemt_tag}" "${telemt_asset}" /tmp/telemt.tar.gz; \
    download_release_asset "${TELEMT_PANEL_REPOSITORY}" "${panel_tag}" "${telemt_panel_asset}" /tmp/telemt-panel.tar.gz; \
    install_binary_from_archive /tmp/telemt.tar.gz telemt /usr/local/bin/telemt; \
    install_binary_from_archive /tmp/telemt-panel.tar.gz telemt-panel /usr/local/bin/telemt-panel; \
    rm -f /tmp/telemt.tar.gz /tmp/telemt-panel.tar.gz; \
    printf '%s\n' "${telemt_tag}" > /usr/local/share/telemt-version; \
    printf '%s\n' "${panel_tag}" > /usr/local/share/telemt-panel-version; \
    test -x /usr/local/bin/telemt; \
    test -x /usr/local/bin/telemt-panel

# GeoLite2 MMDB for telemt-panel GeoIP (no MaxMind license / no runtime download).
# Mirror: P3TERX/GeoLite.mmdb (direct .mmdb over HTTPS).
ARG TELEMT_GEOIP_BASE_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download
ARG TELEMT_GEOIP_DIR=/usr/share/telemt-panel/geoip

RUN set -eux; \
    geoip_dir="${TELEMT_GEOIP_DIR}"; \
    base_url="${TELEMT_GEOIP_BASE_URL}"; \
    mkdir -p "${geoip_dir}"; \
    download_mmdb() { \
        name="$1"; \
        url="${base_url}/${name}"; \
        dest="${geoip_dir}/${name}"; \
        curl -fL --retry 5 --retry-delay 2 -o "${dest}" "${url}"; \
        size="$(wc -c < "${dest}")"; \
        if [ "${size}" -lt 65536 ]; then \
            echo "GeoIP download too small (${size} bytes): ${url}" >&2; \
            exit 1; \
        fi; \
        # MaxMind DB metadata marker: bytes ab cd ef + "MaxMind.com"
        marker="$(printf '\253\315\357MaxMind.com')"; \
        if ! grep -a -F -q "${marker}" "${dest}"; then \
            echo "GeoIP file missing MaxMind DB marker: ${dest}" >&2; \
            exit 1; \
        fi; \
        chmod 0644 "${dest}"; \
    }; \
    download_mmdb GeoLite2-City.mmdb; \
    download_mmdb GeoLite2-ASN.mmdb; \
    download_mmdb GeoLite2-Country.mmdb; \
    { \
        echo "mirror=P3TERX/GeoLite.mmdb"; \
        echo "base_url=${base_url}"; \
        echo "fetched_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
        echo "files=GeoLite2-City.mmdb,GeoLite2-ASN.mmdb,GeoLite2-Country.mmdb"; \
        for name in GeoLite2-City.mmdb GeoLite2-ASN.mmdb GeoLite2-Country.mmdb; do \
            echo "${name}_bytes=$(wc -c < "${geoip_dir}/${name}")"; \
        done; \
    } > "${geoip_dir}/SOURCE.txt"; \
    chmod 0644 "${geoip_dir}/SOURCE.txt"; \
    chmod 0755 "${geoip_dir}"

LABEL org.opencontainers.image.geoip.mirror="P3TERX/GeoLite.mmdb" \
      org.opencontainers.image.geoip.dir="/usr/share/telemt-panel/geoip"

COPY DockerEntrypoint.sh /usr/local/bin/telemt-stack-entrypoint.sh

RUN set -eux; \
    chmod 0755 /usr/local/bin/telemt-stack-entrypoint.sh; \
    test -x /usr/local/bin/telemt; \
    test -x /usr/local/bin/telemt-panel; \
    test -x /usr/local/bin/telemt-stack-entrypoint.sh; \
    test -s /usr/share/telemt-panel/geoip/GeoLite2-City.mmdb; \
    test -s /usr/share/telemt-panel/geoip/GeoLite2-ASN.mmdb; \
    test -s /usr/share/telemt-panel/geoip/GeoLite2-Country.mmdb

EXPOSE 9443
EXPOSE 9091
EXPOSE 9090
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/telemt-stack-entrypoint.sh"]
